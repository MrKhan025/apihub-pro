# API-Hub-Pro (apihub-pro) v2.0 Environment Template
# Copy this file to .env and replace placeholders with your own secrets.
# NEVER commit .env to version control.

APIHUB_APP_NAME=apihub-pro
APIHUB_ENV=development
APIHUB_DEBUG=false
APIHUB_HOST=0.0.0.0
APIHUB_PORT=8000

# Database Configuration (Use SQLite locally/Termux or PostgreSQL in production)
DATABASE_URL=sqlite:///./apihub_pro.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://apihub_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/apihub_pro
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_SSL_MODE=prefer

# Redis Distributed Rate Limiting & Caching
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=apihub:
CACHE_DEFAULT_TTL_SECONDS=60

# Cryptographic Secrets (Leave blank in dev to auto-generate ephemeral runtime keys)
APIHUB_SECRET_KEY=
APIHUB_AUDIT_HMAC_SECRET=
APIHUB_WEBHOOK_SECRET=

# Security & Gateway Thresholds
MAX_REQUEST_BODY_BYTES=1048576
DEFAULT_GATEWAY_TIMEOUT_MS=5000
MAX_GATEWAY_TIMEOUT_MS=30000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
PASSWORD_RESET_TTL_SECONDS=900
DEFAULT_API_KEY_TTL_DAYS=90
DEFAULT_KEY_ROTATION_GRACE_SECONDS=86400
DEFAULT_RPM_LIMIT=60
